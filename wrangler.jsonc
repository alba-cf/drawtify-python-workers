{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "drawtify",
	"main": "src/worker.py",
	"compatibility_date": "2026-05-13",
	"compatibility_flags": [
		"python_workers",
		"python_workflows",
		"disable_python_external_sdk"
	],
	"assets": {
		"directory": "./assets/",
		"binding": "ASSETS"
	},
	// Optional settings (add under "vars"):
	//   "IMAGE_PROVIDER": "workersai" (default, FLUX.2 klein, billed in Neurons) or "openai" (gpt-image-2 via AI Gateway)
	//   "GATEWAY_ID": "<gateway-id>"  (AI Gateway to route through; used by the openai provider)
	"r2_buckets": [
		{
			"binding": "MY_BUCKET",
			"bucket_name": "drawtify-photos"
		}
	],
	// No "id": wrangler creates the KV namespace automatically on first deploy.
	"kv_namespaces": [
		{
			"binding": "CONFIG"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"workflows": [
		{
			"name": "drawtify-workflow",
			"binding": "DRAWTIFY_WORKFLOW",
			"class_name": "DrawtifyWorkflow"
		}
	],
	"observability": {
		"enabled": true
	}
}
