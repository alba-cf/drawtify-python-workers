{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "drawtify",
	"main": "src/worker.py",
	"compatibility_date": "2026-05-13",
	"compatibility_flags": [
		"python_workers",
		"python_workflows",
		"disable_python_external_sdk"
	],
	"assets": {
		"directory": "./assets/",
		"binding": "ASSETS"
	},
	// Optional: route image generation through an AI Gateway by adding
	// "vars": { "GATEWAY_ID": "<your-gateway-id>" }
	"r2_buckets": [
		{
			"binding": "MY_BUCKET",
			"bucket_name": "drawtify-photos"
		}
	],
	// No "id": wrangler creates the KV namespace automatically on first deploy.
	"kv_namespaces": [
		{
			"binding": "CONFIG"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"workflows": [
		{
			"name": "drawtify-workflow",
			"binding": "DRAWTIFY_WORKFLOW",
			"class_name": "DrawtifyWorkflow"
		}
	],
	"observability": {
		"enabled": true
	}
}
